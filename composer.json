{
  "name": "eminisolomon/safehaven",
  "description": "A concise Laravel package for easy integration with Safe Haven MFB's API, offering simplified access to banking features",
  "keywords": [
    "eminisolomon",
    "safehaven",
    "Nigeria Bank",
    "Vas Services"
  ],
  "homepage": "https://github.com/solomonolatunji/safehaven",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Solomon Olatunji",
      "email": "iamsolomonolatunji@gmail.com",
      "role": "Software Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "firebase/php-jwt": "^6.11",
    "guzzlehttp/guzzle": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "Eminisolomon\\SafeHaven\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Eminisolomon\\SafeHaven\\Tests\\": "tests",
      "Workbench\\": "workbench/app"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
    "format": "vendor/bin/pint",
    "lint:check": "vendor/bin/pint --test",
    "lint": "vendor/bin/phpstan analyse --debug --memory-limit=512M",
    "analyse": "vendor/bin/phpstan analyse --debug --memory-limit=512M",
    "test:unit": "vendor/bin/pest",
    "build": "vendor/bin/testbench workbench:build --ansi",
    "configure": "php configure.php",
    "check": "composer validate --strict --no-check-publish && php configure.php && vendor/bin/pint --test && vendor/bin/phpstan analyse --debug --memory-limit=512M && vendor/bin/pest",
    "serve": "vendor/bin/testbench serve"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Eminisolomon\\SafeHaven\\SafeHavenServiceProvider"
      ],
      "aliases": {
        "SafeHaven": "Eminisolomon\\SafeHaven\\SafeHaven"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "orchestra/testbench": "^10.2",
    "pestphp/pest": "^3.8",
    "pestphp/pest-plugin-laravel": "^3.0",
    "mockery/mockery": "^1.6",
    "laravel/pint": "^1.24",
    "phpstan/phpstan": "^2.1"
  }
}
